{
  "name": "nemesis-ide",
  "version": "0.1.0",
  "description": "Nemesis IDE - A modern, lightweight, extensible web-native desktop IDE built with React, Monaco Editor, and Node.js",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "server": "node server/index.js",
    "client": "vite",
    "dev": "concurrently \"node server/index.js\" \"vite\"",
    "build": "vite build",
    "desktop:dev": "concurrently -k \"node server/index.js\" \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "desktop:preview": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.arazzki.nemesiside",
    "productName": "Nemesis IDE",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "server/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nemesis IDE"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "arazzki",
        "repo": "NemesisIDE"
      }
    ]
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "cors": "^2.8.5",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "wait-on": "^9.5.1"
  }
}
